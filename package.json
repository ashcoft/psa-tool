{
  "name": "psa",
  "version": "1.3.0",
  "description": "Power System Analysis Tool (PSA)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "NEXT_OUTPUT=export NEXT_PUBLIC_BASE_PATH=/psa next build",
    "start": "next start",
    "lint": "eslint src/ --max-warnings 1",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release": "semantic-release",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "power-systems",
    "analysis",
    "simulation"
  ],
  "author": "PSA Team",
  "license": "GPL-3.0",
  "overrides": {
    "postcss": "8.5.33",
    "browserslist": "4.29.6",
    "brace-expansion@^1": "1.1.18",
    "brace-expansion@^5": "5.0.9",
    "js-yaml": "5.5.0"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^31.0.0",
    "semantic-release": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
